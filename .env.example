# ── 카카오 (notify / auth) ─────────────────────────────────────
# developers.kakao.com 앱 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 앱 > 보안 > Client Secret
KAKAO_CLIENT_SECRET=
# 최초 1회 수동 발급(인가 코드 → 토큰 교환). 이후 회전은 자동
KAKAO_REFRESH_TOKEN=

# ── Gemini (summarize) ────────────────────────────────────────
# aistudio.google.com > API 키. 무료 티어만 사용
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── 네이버 검색 API (collectors/news) ──────────────────────────
# NAVER Cloud Platform > NAVER API HUB > Application. 헤더는 X-NCP-APIGW-*
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── Reddit OAuth (collectors/community) ───────────────────────
# reddit.com/prefs/apps > script 타입 앱
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── 공공데이터포털 (collectors/realestate) ─────────────────────
# data.go.kr > 마이페이지 > 일반 인증키(디코딩)
DATA_GO_KR_SERVICE_KEY=

# ── 한국부동산원 R-ONE (collectors/realestate/price) ───────────
RONE_API_KEY=

# ── GitHub (refresh token 회전용) ─────────────────────────────
# fine-grained PAT, 이 레포의 Secrets Read/Write 권한 필요
GH_SECRETS_PAT=
# Actions에서는 자동 주입. 로컬에서만 직접 지정 (owner/repo)
GITHUB_REPOSITORY=

# ── 사이트 ────────────────────────────────────────────────────
PAGES_BASE_URL=

# ── 공통 상수 (기본값 있음, 필요 시만 덮어쓰기) ─────────────────
# HTTP_TIMEOUT_MS=10000
# HTTP_RETRY_MAX=3
# HTTP_RETRY_BASE_MS=1000
# GEMINI_CALL_GAP_MS=30000
